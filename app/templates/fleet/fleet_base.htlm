
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Fleet Management - MatatuHub{% endblock %}</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">

    <style>
        .fleet-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px;
        }

        .fleet-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        .fleet-header h1 {
            margin: 0 0 6px;
        }

        .fleet-header p {
            margin: 0;
            color: #666;
        }

        .fleet-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 24px;
            padding: 14px;
            background: #f3f5f7;
            border-radius: 8px;
        }

        .fleet-nav a {
            text-decoration: none;
            padding: 9px 13px;
            border-radius: 5px;
            color: #263445;
        }

        .fleet-nav a:hover {
            background: #e0e6ed;
        }

        .fleet-card {
            background: #fff;
            border: 1px solid #e0e4e8;
            border-radius: 8px;
            padding: 22px;
            margin-bottom: 22px;
        }

        .fleet-card h2 {
            margin-top: 0;
        }

        .fleet-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .fleet-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
        }

        .fleet-table th,
        .fleet-table td {
            text-align: left;
            padding: 12px;
            border-bottom: 1px solid #e5e7eb;
        }

        .fleet-table th {
            background: #f3f5f7;
        }

        .fleet-form {
            display: grid;
            gap: 16px;
            max-width: 650px;
        }

        .fleet-form label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .fleet-form input,
        .fleet-form select,
        .fleet-form textarea {
            box-sizing: border-box;
            width: 100%;
            padding: 10px;
            border: 1px solid #cbd2d9;
            border-radius: 5px;
            font: inherit;
        }

        .fleet-form textarea {
            min-height: 110px;
            resize: vertical;
        }

        .fleet-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 16px 0;
        }

        .fleet-button {
            display: inline-block;
            border: none;
            border-radius: 5px;
            padding: 10px 15px;
            background: #263d59;
            color: #fff;
            text-decoration: none;
            cursor: pointer;
            font: inherit;
        }

        .fleet-button:hover {
            opacity: 0.9;
        }

        .fleet-button-secondary {
            background: #596675;
        }

        .fleet-button-danger {
            background: #a93232;
        }

        .fleet-flash {
            padding: 12px 15px;
            margin-bottom: 12px;
            background: #eef5ff;
            border-left: 4px solid #3568a8;
            border-radius: 4px;
        }

        .fleet-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
        }

        .fleet-detail {
            padding: 14px;
            background: #f7f8fa;
            border-radius: 5px;
        }

        .fleet-detail strong {
            display: block;
            margin-bottom: 5px;
        }

        .fleet-muted {
            color: #68727d;
        }

        .fleet-footer {
            padding: 20px;
            text-align: center;
            color: #68727d;
            border-top: 1px solid #e5e7eb;
            margin-top: 30px;
        }

        @media (max-width: 600px) {
            .fleet-wrapper {
                padding: 14px;
            }

            .fleet-card {
                padding: 15px;
            }
        }
    </style>
</head>

<body>
    <main class="fleet-wrapper">
        <header class="fleet-header">
            <div>
                <h1>MatatuHub Fleet Management</h1>
                <p>Manage vehicles, documents, maintenance and allocations.</p>
            </div>
        </header>

        <nav class="fleet-nav">
            <a href="{{ url_for('fleet.list_vehicles') }}">Vehicles</a>
            <a href="{{ url_for('fleet.new_vehicle') }}">Add Vehicle</a>
            <a href="{{ url_for('fleet.new_allocation') }}">New Allocation</a>
            <a href="{{ url_for('fleet.new_accident') }}">Report Accident</a>
            <a href="{{ url_for('home') }}">Home</a>
        </nav>

        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                {% for category, message in messages %}
                    <div class="fleet-flash" role="status">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endif %}
        {% endwith %}

        {% block fleet_content %}{% endblock %}
    </main>

    <footer class="fleet-footer">
        MatatuHub Fleet Management
    </footer>
</body>
</html>

